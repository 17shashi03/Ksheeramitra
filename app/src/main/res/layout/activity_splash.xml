<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- LARGE LOGO -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="282dp"
            android:layout_height="145dp"
            android:contentDescription="Ksheeramitra logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ksheeramitra_logo" />

        <!-- APP NAME -->
        <TextView
            android:id="@+id/txtSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ksheeramitra"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold" />

        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/txtSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="Smart Dairy Management System"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnPrimary" />

    </LinearLayout>

</ScrollView>
